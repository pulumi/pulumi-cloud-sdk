<!--
  Pin restore to nuget.org. This SDK is mirrored to a standalone repository, so it
  must not inherit package sources from any enclosing NuGet.config (e.g. the local
  feeds other Pulumi monorepos configure).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
